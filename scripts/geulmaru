#!/bin/bash
# RSS Collector (글마루) CLI 실행 스크립트

set -e  # 에러 발생 시 즉시 종료

# 스크립트 디렉토리 찾기
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# 가상환경 경로
VENV_DIR="$PROJECT_ROOT/venv"

# 가상환경이 없으면 에러
if [ ! -d "$VENV_DIR" ]; then
    echo "❌ 가상환경이 없습니다. 먼저 다음 명령어를 실행해주세요:"
    echo "   ./scripts/setup.sh"
    exit 1
fi

# Python이 가상환경에 없으면 에러
if [ ! -f "$VENV_DIR/bin/python" ]; then
    echo "❌ 가상환경에 Python이 없습니다."
    echo "   ./scripts/setup.sh를 다시 실행해주세요."
    exit 1
fi

# 가상환경 활성화
source "$VENV_DIR/bin/activate"

# urllib3 경고 비활성화
export PYTHONWARNINGS="ignore"

# 명령어 인자가 없으면 도움말 표시
if [ $# -eq 0 ]; then
    python -m src.main --help
    exit 0
fi

# 서브커맨드만 입력한 경우 자동으로 --help 추가
# 예: feed -> feed --help, articles -> articles --help
if [ $# -eq 1 ]; then
    COMMAND="$1"
    case "$COMMAND" in
        feed|articles)
            python -m src.main "$@" --help
            exit 0
            ;;
    esac
fi

# 실행
python -m src.main "$@"

